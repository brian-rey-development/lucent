{
  "name": "lucent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lucent": "node apps/cli/dist/main.js",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
